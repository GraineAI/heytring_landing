# Tring landing — environment template. Copy to .env.local for local dev, and set the same
# variables in Vercel (Project → Settings → Environment Variables) for production.
#
# .env.local is gitignored; THIS file is tracked on purpose (see .gitignore "!.env.example"),
# so never put a real secret in it.

# ── Existing ──────────────────────────────────────────────────────────────────────────────────
# Neon Postgres — waitlist signups + store-link clicks.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Password for /admin. The session cookie is an HMAC of this value, so CHANGING IT SIGNS EVERYONE
# OUT — that is the intended way to revoke access.
ADMIN_PASSWORD=

# ── PostHog product metrics on /admin (added with the metrics dashboard) ──────────────────────
# WITHOUT THESE the Product-metrics card renders "Set POSTHOG_PERSONAL_API_KEY and
# POSTHOG_PROJECT_ID in .env.local" and nothing else on /admin is affected.
#
# A **PERSONAL** api key (starts phx_), NOT the phc_ project token shipped in the mobile app.
# The phc_ token is write-only — PostHog answers reads with 403 — so it cannot be used here.
# Create at: PostHog → Settings → Personal API keys. Scope it to `query:read` on project 493951.
#
# ⚠️ NEVER prefix any of these with NEXT_PUBLIC_. That inlines the value into the client bundle,
# which would publish a key that can read the entire PostHog project in the page source of a
# public marketing site. Reading them server-side in /api/admin/posthog is the whole point.
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here

# Numeric project id — PostHog → Settings → Project → Project ID.
POSTHOG_PROJECT_ID=493951

# API host. NOTE this is us.posthog.com, NOT us.i.posthog.com — the `i.` host is INGESTION only
# and will not serve queries. (The mobile app uses the i. host, which is correct for sending.)
POSTHOG_API_HOST=https://us.posthog.com
